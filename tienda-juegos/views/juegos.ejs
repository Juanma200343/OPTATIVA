<h1><%= titulo %></h1>

<p>Total: <%= arrayJuegos.length %> juegos</p>

<% if (arrayJuegos.length > 0) { %>

<table class="table table-striped">
  <thead class="table-dark">
    <tr>
      <th>Título</th>
      <th>Plataforma</th>
      <th>Precio</th>
    </tr>
  </thead>

  <tbody>
    <% arrayJuegos.forEach(juego => { %>
      <tr>
        <td><%= juego.titulo %></td>
        <td><%= juego.plataforma %></td>
        <td><%= juego.precio.toFixed(2) %> €</td>
      </tr>
    <% }) %>
  </tbody>
</table>

<% } else { %>

<p>No hay juegos en el catálogo</p>

<% } %>